# Spotter environment variables. Copy to .env and fill in.
# Every variable and its rules live in rules/env.md. Never commit real values.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/spotter?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/spotter?schema=public"

# --- Models ---
GEMINI_API_KEY=

# --- Payments ---
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Application ---
SESSION_SECRET=
STAFF_SESSION_SECRET=
APP_URL=http://localhost:3000
CRON_SECRET=

# --- Check in ---
# Only the exact string "true" enables the simulated verifier.
CHECKIN_SIMULATED=false
# Required only when a real keypad verifier is deployed.
# CHECKIN_VERIFY_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
